# ~/.config/ghostty/config.ghosty

# =========================
# Aesthetics
# ========================

theme = Monokai Classic

font-family = "JetBrainsMono Nerd Font"
font-size = 14

background-opacity = 0.9
background-blur = 16
background-image = ~/.config/ghostty/howlbg.jpeg
background-image-position = center
background-image-fit = cover
background-image-opacity = 0.05

# Command to run on ghostty startup (what shell to use)
# Could replace this with a custom function if several startup items are needed?
command = zsh

macos-option-as-alt = left

confirm-close-surface = false
quit-after-last-window-closed = true
