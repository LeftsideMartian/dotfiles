{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
	"logo": {
		"type": "auto",
		"source": "~/.config/fastfetch/img.txt",
		"width": 50,
		"height": 15,
		"padding": {
			"top": 1,
			"left": 10,
			"right": 2,
		},
	},
	"modules": [
		{
			"type": "title",
			"format": "{##F92672}{user-name}{#}{##F8F8F2}@{#}{##F92672}{host-name}{#}",
			"key": "",
			"keyColor": "#66D9EF",
		},

		{
			"type": "custom",
			"format": "   \u001b[90m┌──────────────────────\u001b[97mComputer\u001b[90m──────────────────────┐",
		},
		{
			"type": "os",
			"key": "  OS",
			"keyColor": "#66D9EF",
		},
		{
			"type": "host",
			"key": "  ├",
			"keyColor": "#569CD6",
		},
		{
			"type": "cpu",
			"key": "  ├",
			"keyColor": "#569CD6",
		},
		{
			"type": "memory",
			"key": "  ├",
			"keyColor": "#569CD6",
		},
		{
			"type": "battery",
			"key": "  └󱊣",
			"keyColor": "#569CD6",
		},
		{
			"type": "custom",
			"format": "\u001b[90m└────────────────────────────────────────────────────┘",
		},

		{
			"type": "custom",
			"format": "\u001b[38;2;102;217;239m━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[90m ◆ \u001b[38;2;166;226;46m━━━━━━━━━━━━━━━━━━━━━━━━━",
		},

		{
			"type": "custom",
			"format": "\u001b[90m┌──────────────────────\u001b[97mTerminal\u001b[90m──────────────────────┐",
		},
		{
			"type": "terminal",
			"key": "  Terminal",
			"keyColor": "#A3FF12",
		},
		{
			"type": "terminalfont",
			"key": "  ├",
			"keyColor": "#8FD400",
		},
		{
			"type": "shell",
			"key": "  ├",
			"keyColor": "#8FD400",
		},
		{
			"type": "editor",
			"key": "  ├󰊄",
			"keyColor": "#8FD400",
		},
		{
			"type": "localip",
			"key": "  └󰩟",
			"keyColor": "#8FD400",
		},
		{
			"type": "custom",
			"format": "\u001b[90m└────────────────────────────────────────────────────┘",
		},
		"break",
		{
			"type": "colors",
			"paddingLeft": 1,
		},
	],
}
