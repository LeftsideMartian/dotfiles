{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
	"logo": {
		"type": "chafa",
		"source": "~/.config/fastfetch/img.png",
		"padding": {
			"top": 2,
			"left": 6,
			"right": 2,
		},
		"chafa": {
			"symbols": "block",
		},
	},
	"modules": [
		{
			"type": "title",
			"format": "{##F92672}{user-name}{#}{##F8F8F2}@{#}{##F92672}{host-name}{#}",
			"key": "",
			"keyColor": "#66D9EF",
		},

		{
			"type": "custom",
			"format": "\u001b[38;2;117;113;94m┌──────────────────────\u001b[38;2;248;248;242mComputer\u001b[38;2;117;113;94m──────────────────────┐",
		},
		{
			"type": "os",
			"key": "  OS",
			"keyColor": "#66D9EF",
		},
		{
			"type": "host",
			"key": "  ├",
			"keyColor": "#66D9EF",
		},
		{
			"type": "cpu",
			"key": "  ├",
			"keyColor": "#66D9EF",
		},
		{
			"type": "memory",
			"key": "  ├",
			"keyColor": "#66D9EF",
		},
		{
			"type": "battery",
			"key": "  └󱊣",
			"keyColor": "#66D9EF",
		},
		{
			"type": "custom",
			"format": "\u001b[38;2;117;113;94m└────────────────────────────────────────────────────┘",
		},

		{
			"type": "custom",
			"format": "\u001b[38;2;102;217;239m━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[38;2;117;113;94m ◆ \u001b[38;2;166;226;46m━━━━━━━━━━━━━━━━━━━━━━━━━",
		},

		{
			"type": "custom",
			"format": "\u001b[38;2;117;113;94m┌──────────────────────\u001b[38;2;248;248;242mTerminal\u001b[38;2;117;113;94m──────────────────────┐",
		},
		{
			"type": "terminal",
			"key": "  Terminal",
			"keyColor": "#A6E22E",
		},
		{
			"type": "terminalfont",
			"key": "  ├",
			"keyColor": "#A6E22E",
		},
		{
			"type": "shell",
			"key": "  ├",
			"keyColor": "#A6E22E",
		},
		{
			"type": "editor",
			"key": "  ├󰊄",
			"keyColor": "#A6E22E",
		},
		{
			"type": "localip",
			"key": "  └󰩟",
			"keyColor": "#A6E22E",
		},
		{
			"type": "custom",
			"format": "\u001b[38;2;117;113;94m└────────────────────────────────────────────────────┘",
		},
		"break",
		{
			"type": "colors",
			"paddingLeft": 1,
		},
	],
}
